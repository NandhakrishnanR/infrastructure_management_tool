# InfraPilot Configuration Example
# Copy to .env for local development

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:root@localhost:5432/infrapilot?schema=public

# Cache & Queues (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
JWT_SECRET=infrapilot_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=24h
COOKIE_SECURE=false

# Demo & Terraform Settings
DEMO_MODE=true
TERRAFORM_DIR=../infrastructure/terraform/demo
TERRAFORM_BINARY=terraform
EXECUTION_TIMEOUT_MS=60000
