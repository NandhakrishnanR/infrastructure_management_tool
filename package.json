{
  "name": "infrapilot-monorepo",
  "version": "1.0.0",
  "description": "InfraPilot - Enterprise Self-Service Infrastructure Management Platform",
  "scripts": {
    "dev:api": "npm --prefix backend run dev",
    "dev:worker": "npm --prefix backend run worker",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test": "npm --prefix backend run test",
    "db:push": "npm --prefix backend run db:push",
    "db:seed": "npm --prefix backend run db:seed",
    "generate:presentation": "npm --prefix backend run generate:presentation",
    "generate:docs": "python backend/scripts/generateDocumentation.py",
    "generate:workflow": "python backend/scripts/generateWorkflowDoc.py",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "infrastructure",
    "terraform",
    "self-service",
    "bullmq",
    "express",
    "react",
    "prisma",
    "postgresql"
  ],
  "author": "Senior IT Application Developer Candidate",
  "license": "MIT"
}
